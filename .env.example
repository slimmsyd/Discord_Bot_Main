# Copy to .env for local dev. On Railway, set these in the Variables tab instead.
# All values below are placeholders — never commit real secrets.

DISCORD_BOT_TOKEN=your-discord-bot-token-here
DEEPSEEK_API_KEY=your-deepseek-key-here

# Comma- or space-separated Discord user IDs allowed to run owner-only commands
# (e.g. /exportmembers). Users with server Administrator also pass the gate.
OWNER_IDS=

# Where the join-tracking log is persisted (defaults to join_log.json in CWD).
# JOIN_LOG_PATH=join_log.json
